#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

// Tastenpositionen (0-basiert, Zeile für Zeile, links nach rechts)
// Zeile 0:  0- 5 links,  6-11 rechts
// Zeile 1: 12-17 links, 18-23 rechts
// Zeile 2: 24-29 links, 30-35 rechts
// Daumen:  36-38 links, 39-41 rechts
#define KEYS_L 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29
#define KEYS_R 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35
#define THUMBS 36 37 38 39 40 41

/ {
    behaviors {
        // Home-Row-Mod linke Hand: Modifier greift nur, wenn danach
        // eine Taste der rechten Hand oder ein Daumen gedrückt wird
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        // Home-Row-Mod rechte Hand: spiegelbildlich
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };

        // Shift linke Hand (F): wie hml, aber ohne require-prior-idle-ms,
        // damit Shift auch beim schnellen Tippen greift
        hsl: home_row_shift_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        // Utility-Taste: Tippen = Aktion 2, Halten (400 ms) = Aktion 1
        htu: hold_tap_utility {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <400>;
            bindings = <&kp>, <&kp>;
        };

        // Shift rechte Hand (J): spiegelbildlich
        hsr: home_row_shift_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &kp TAB   &kp Q            &kp W           &kp E           &kp R            &kp T   &kp Y &kp U            &kp I           &kp O           &kp P             &kp DEL
                &kp ESC   &hml LCTRL A     &hml LALT S     &hml LGUI D     &hsl LSHFT F     &kp G   &kp H &hsr RSHFT J     &hmr RGUI K     &hmr RALT L     &hmr RCTRL SEMI   &kp SQT
                &htu LC(LG(Q)) LC(LG(SPACE))   &kp Z   &kp X   &kp C   &kp V   &kp B   &kp N   &kp M   &kp COMMA   &kp DOT   &kp FSLH   &htu LC(SPACE) LG(LS(N4))
                                           &caps_word      &mo NAV         &kp SPACE                &kp RET               &mo SYM         &kp BSPC
            >;
        };

        // NAV: links Modifier und Bearbeiten, rechts Navigation
        nav {
            display-name = "NAV";
            bindings = <
                &kp TAB  &kp N1      &kp N2      &kp N3      &kp N4         &kp N5             &kp N6    &kp N7    &kp N8    &kp N9    &kp N0 &kp BSPC
                &trans   &kp LCTRL   &kp LALT    &kp LGUI    &kp LSHFT      &trans             &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &trans &trans
                &trans   &kp LG(Z)   &kp LG(X)   &kp LG(C)   &kp LG(V)      &kp LG(LS(Z))      &kp HOME  &kp PG_DN &kp PG_UP &kp END   &trans &trans
                                     &trans      &trans      &trans                            &trans    &trans    &trans
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &kp GRAVE &kp EXCL &kp AT   &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp ASTRK &trans &trans   &trans
                &kp TILDE &kp LT   &kp LBRC &kp LPAR &kp LBKT &kp EQUAL   &trans    &trans    &trans    &trans &trans   &trans
                &kp BSLH  &kp GT   &kp RBRC &kp RPAR &kp RBKT &kp MINUS   &kp UNDER &kp PLUS  &trans    &trans &kp PIPE &trans
                                   &trans   &trans   &trans               &trans    &trans    &trans
            >;
        };

        // ADJ (NAV + SYM gleichzeitig): F-Tasten, Lautstärke, Bluetooth
        adj {
            display-name = "ADJ";
            bindings = <
                &kp TAB   &trans &kp F7 &kp F8 &kp F9 &kp F12   &kp C_VOL_DN  &kp C_MUTE    &kp C_VOL_UP  &trans        &trans        &kp BSPC
                &kp LCTRL &trans &kp F4 &kp F5 &kp F6 &kp F11   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans
                &kp LSHFT &trans &kp F1 &kp F2 &kp F3 &kp F10   &trans        &trans        &trans        &trans        &trans        &bt BT_CLR
                                   &trans &trans &trans         &trans &trans &trans
            >;
        };

        mouse {
            display-name = "MOU";
            bindings = <
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                            &mkp MCLK &mkp LCLK &mkp RCLK           &mkp LCLK &mkp RCLK &mkp MCLK
            >;
        };

        extra_2 {
                status = "reserved";
        };

        extra_3 {
                status = "reserved";
        };
    };
};
